{
  "name": "noetic-atlas",
  "version": "2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13 <25"
  },
  "scripts": {
    "predev": "node scripts/build/prepare-third-party.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "predev:web": "node scripts/build/prepare-third-party.mjs",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "prebuild": "node scripts/build/prepare-third-party.mjs && node scripts/build/clean-build.mjs",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json --noEmit && vite build",
    "start": "node dist/server/main.js",
    "test": "node scripts/test.mjs",
    "docs:check": "node scripts/qa/check-docs.mjs",
    "mobile:typecheck": "tsc -p tsconfig.mobile.json --noEmit",
    "mobile:build": "npm run mobile:typecheck && node scripts/build/prepare-mobile.mjs && vite build --config vite.mobile.config.ts",
    "mobile:sync": "npm run mobile:build && cap sync android",
    "android:debug": "node scripts/build/android-build.mjs --mode Debug",
    "data:validate": "node scripts/release/validate-public-data.mjs",
    "content:validate": "tsx scripts/content/manage.ts validate",
    "content:package": "tsx scripts/content/manage.ts package",
    "content:domains": "tsx scripts/content/export-domains.ts",
    "data:pack": "node dist/server/commands/pack-legacy-data.js",
    "data:unpack": "node dist/server/commands/extract-database-package.js",
    "content:import": "tsx scripts/content/manage.ts import",
    "content:review": "tsx scripts/content/review.ts",
    "release": "node scripts/release.mjs",
    "release:prepare": "node scripts/release/prepare-github.mjs",
    "release:clean": "node scripts/release/cleanup.mjs",
    "android:release": "node scripts/build/android-build.mjs --mode Release",
    "android:signing:init": "node scripts/build/android-signing.mjs init",
    "android:signing:verify": "node scripts/build/android-signing.mjs verify",
    "release:smoke": "node scripts/qa/check-release.mjs",
    "windows:release": "node scripts/release/release-windows.mjs",
    "windows:smoke": "node scripts/qa/check-windows.mjs",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "check": "npm run format:check && npm run architecture:check && npm run generated:check -- --source-only && npm run typecheck && npm run mobile:typecheck && npm run docs:check",
    "postbuild": "node scripts/build/start-cache.mjs",
    "qa": "node scripts/qa/run.mjs",
    "qa:list": "node scripts/qa/run.mjs --list",
    "architecture:check": "node scripts/qa/check-architecture.mjs",
    "qa:android:build": "node scripts/testing/android/build-qa.mjs",
    "qa:android": "node scripts/qa/check-android-layout.mjs",
    "generated:prepare": "node scripts/build/generated.mjs prepare",
    "generated:check": "node scripts/build/generated.mjs check",
    "generated:clean": "node scripts/build/generated.mjs clean"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@fastify/static": "^10.1.9",
    "@fastify/swagger": "^9.9.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@noble/hashes": "2.2.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "fastify": "^5.12.7",
    "fflate": "0.8.3",
    "html-to-image": "^1.11.13",
    "katex": "^0.19.1",
    "kysely": "0.29.7",
    "lucide-react": "^0.468.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "sql.js": "^1.15.1",
    "ts-fsrs": "5.4.2",
    "unified": "^11.0.5",
    "zod": "^4.6.7"
  },
  "overrides": {
    "katex": "$katex",
    "@electron/asar": {
      "glob": "^14.0.3",
      "minimatch": "^11.0.4"
    }
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.0.0",
    "prettier": "3.9.10",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
