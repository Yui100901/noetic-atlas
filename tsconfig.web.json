{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "skipLibCheck": true, "moduleResolution": "Bundler", "allowImportingTsExtensions": true,
    "resolveJsonModule": true, "isolatedModules": true, "esModuleInterop": true,
    "noEmit": true, "jsx": "react-jsx", "strict": true, "types": ["vite/client"],
    "paths": { "@platform": ["./web/shared/lib/platform.ts"] }
  },
  "include": ["web", "shared", "vite.config.ts"]
}
